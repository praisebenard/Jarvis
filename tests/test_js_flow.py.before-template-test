"""Synthetic offline JavaScript source-flow analyzer tests."""

import hashlib
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parents[1]


class JSFlowTests(unittest.TestCase):
    def run_fixture(self, source, suffix=".js", commands=None, existing_report=None):
        temporary = tempfile.TemporaryDirectory(prefix="jarvis-js-flow-")
        self.addCleanup(temporary.cleanup)
        workdir = Path(temporary.name)
        fixture = workdir / f"synthetic{suffix}"
        fixture.write_text(source)
        reports_dir = workdir / "reports"
        if existing_report:
            reports_dir.mkdir()
            (reports_dir / existing_report[0]).write_text(existing_report[1])
        command_text = commands or f"js-flow {fixture}\nexit\n"
        result = subprocess.run(
            [sys.executable, str(PROJECT_ROOT / "jarvis.py")],
            input=command_text,
            text=True,
            capture_output=True,
            cwd=workdir,
            timeout=20,
            check=False,
        )
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        return result, fixture, reports_dir

    def test_direct_source_to_inner_html_includes_evidence_and_locations(self):
        result, fixture, reports_dir = self.run_fixture(
            "target.innerHTML = location.search;\n"
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertIn("Vulnerability status: UNCONFIRMED", report)
        self.assertIn(f"location.search at {fixture.name}:1", report)
        self.assertIn(f"innerHTML at {fixture.name}:1", report)
        self.assertIn("target.innerHTML = location.search;", report)
        self.assertIn("does not prove runtime reachability", report)
        self.assertIn("Severity: NEEDS_REVIEW", report)
        self.assertIn("Vulnerability status remains UNCONFIRMED", report)
        self.assertIn("static patterns or traces do not demonstrate exploitability", report)
        self.assertIn("Report provenance:", report)
        self.assertIn("Analysis started (UTC):", report)
        self.assertIn(f"Source file: {fixture.resolve()}", report)
        self.assertIn(
            f"Source SHA-256: {hashlib.sha256(fixture.read_text().encode()).hexdigest()}",
            report,
        )
        self.assertIn("Matches current file when report was prepared: YES", report)
        self.assertIn("Analyzer source SHA-256:", report)
        self.assertIn("Source matched analyzed snapshot when report was prepared: YES", report)
        self.assertIn("JARVIS: JavaScript flow evidence saved", result.stdout)

    def test_simple_variable_alias_is_traced(self):
        result, fixture, reports_dir = self.run_fixture(
            "const input = window.location.hash;\n"
            "let copy = input;\n"
            "target.innerHTML = copy;\n"
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertIn(f"window.location.hash at {fixture.name}:1", report)
        self.assertIn("Assignment evidence: Line 2: copy = input", report)
        self.assertIn(f"innerHTML at {fixture.name}:3", report)
        self.assertIn("Vulnerability status: UNCONFIRMED", report)
        self.assertIn("Severity: NEEDS_REVIEW", report)

    def test_url_search_params_get_flow_is_traced_with_all_locations(self):
        _, fixture, reports_dir = self.run_fixture(
            "const params = new URLSearchParams(location.search);\n"
            'const message = params.get("message");\n'
            'document.getElementById("output").innerHTML = message;\n'
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertIn(f"location.search at {fixture.name}:1", report)
        self.assertIn("Assignment evidence: Line 1: const params = new URLSearchParams(location.search);", report)
        self.assertIn('Assignment evidence: Line 2: message = params.get("message")', report)
        self.assertIn(f"innerHTML at {fixture.name}:3", report)
        self.assertIn('document.getElementById("output").innerHTML = message;', report)
        self.assertIn("Vulnerability status: UNCONFIRMED", report)

    def test_unrelated_get_receiver_is_not_treated_as_a_source(self):
        _, _, reports_dir = self.run_fixture(
            "const params = new URLSearchParams(location.search);\n"
            'const message = unrelated.get("message");\n'
            "target.innerHTML = message;\n"
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertNotIn("Candidate 1:", report)
        self.assertIn(".get() receiver unrelated is not connected", report)

    def test_static_url_search_params_input_is_not_assumed_untrusted(self):
        _, _, reports_dir = self.run_fixture(
            'const params = new URLSearchParams("?message=static");\n'
            'const message = params.get("message");\n'
            "target.innerHTML = message;\n"
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertNotIn("Candidate 1:", report)
        self.assertIn("unsupported URLSearchParams or .get() expression", report)

    def test_reassigned_url_search_params_receiver_invalidates_get_flow(self):
        _, _, reports_dir = self.run_fixture(
            "let params = new URLSearchParams(location.search);\n"
            "params = other;\n"
            'const message = params.get("message");\n'
            "target.innerHTML = message;\n"
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertNotIn("Candidate 1:", report)
        self.assertIn("reassignment of params makes later flows ambiguous", report)
        self.assertIn(".get() receiver params is not connected", report)

    def test_reassigned_get_result_invalidates_sink_flow(self):
        _, _, reports_dir = self.run_fixture(
            "const params = new URLSearchParams(location.search);\n"
            'let message = params.get("message");\n'
            'message = "static";\n'
            "target.innerHTML = message;\n"
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertNotIn("Candidate 1:", report)
        self.assertIn("reassignment of message makes later flows ambiguous", report)

    def test_unrelated_source_and_sink_variables_do_not_form_a_candidate(self):
