    def test_unsupported_expression_remains_unresolved(self):
        _, _, reports_dir = self.run_fixture(
            "const input = location.search;\n"
            "const transformed = sanitize(input);\n"
            "target.innerHTML = transformed;\n"
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertNotIn("Candidate 1:", report)
        self.assertIn("unsupported assignment expression involving tracked data", report)

    def test_unsupported_extension_is_rejected(self):
        result, _, reports_dir = self.run_fixture(
            "target.innerHTML = location.search;\n", suffix=".txt"
        )
        self.assertIn("unsupported; use a local .js, .mjs, or .cjs file", result.stdout)
        self.assertFalse(reports_dir.exists())

    def test_secret_like_literal_is_reported_with_value_redacted(self):
        secret = "synthetic_secret_value_42"
        result, fixture, reports_dir = self.run_fixture(
            f'const API_TOKEN = "{secret}";\n'
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertIn("Potential hard-coded secret-like literals:", report)
        self.assertIn(f"API_TOKEN at {fixture.name}:1", report)
        self.assertIn("API_TOKEN = [REDACTED]", report)
        self.assertIn("Severity: NEEDS_REVIEW", report)
        self.assertIn("Pattern confidence: High", report)
        self.assertIn("Vulnerability status: UNCONFIRMED", report)
        self.assertNotIn(secret, report)
        self.assertNotIn(secret, result.stdout)
        self.assertNotIn(secret, result.stderr)

    def test_secret_placeholder_is_not_reported(self):
        _, _, reports_dir = self.run_fixture(
            'const API_KEY = "your_api_key_here";\n'
            'const token = "example-token-value";\n'
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertNotIn("Potential hard-coded secret-like literals:", report)

    def test_client_side_role_check_is_only_a_review_note(self):
        _, fixture, reports_dir = self.run_fixture(
            'if (user.role === "admin") {\n'
            '  showAdminControls();\n'
            '}\n'
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertIn("Client-side authorization-related review notes", report)
        self.assertIn(f"{fixture.name}:1: condition references role", report)
        self.assertIn("not vulnerability findings", report)
        self.assertIn("do not establish a server-side authorization failure", report)
        self.assertNotIn("account takeover confirmed", report.lower())

    def test_report_name_is_distinct_and_existing_report_is_preserved(self):
        with tempfile.TemporaryDirectory(prefix="jarvis-js-report-path-") as temporary:
            workdir = Path(temporary)
            fixture = workdir / "synthetic.js"
            fixture.write_text("target.innerHTML = location.search;\n")
            reports_dir = workdir / "reports"
            reports_dir.mkdir()
            source_hash = hashlib.sha256(str(fixture.resolve()).encode("utf-8")).hexdigest()[:10]
            existing_name = f"synthetic_{source_hash}_js_flow.txt"
            sentinel = "existing report must remain unchanged\n"
            existing_path = reports_dir / existing_name
            existing_path.write_text(sentinel)
            result = subprocess.run(
                [sys.executable, str(PROJECT_ROOT / "jarvis.py")],
                input=f"js-flow {fixture}\nexit\n",
                text=True,
                capture_output=True,
                cwd=workdir,
                timeout=20,
                check=False,
            )
            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
            generated = list(reports_dir.glob("*_js_flow*.txt"))
            self.assertEqual(len(generated), 2)
            self.assertEqual(existing_path.read_text(), sentinel)
            self.assertTrue((reports_dir / f"synthetic_{source_hash}_js_flow_1.txt").is_file())
            self.assertIn("JavaScript flow evidence saved", result.stdout)



    def test_unknown_helper_does_not_prove_input_is_safe(self):
        _, _, reports_dir = self.run_fixture(
            "const input = location.search;\\n"
            "const cleaned = sanitize(input);\\n"
            "target.innerHTML = cleaned;\\n"
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertNotIn("Candidate 1:", report)
        self.assertNotIn("Candidate 1:", report)
        self.assertIn("No complete supported source-to-innerHTML trace", report)

    def test_multiple_aliases_preserve_supported_source_flow(self):
        _, fixture, reports_dir = self.run_fixture(
            "const first = window.location.hash;\\n"
            "const second = first;\\n"
            "const third = second;\\n"
            "target.innerHTML = third;\\n"
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        # Three aliases are currently outside the analyzer's supported
        # subset; keep this regression conservative until implemented.
        self.assertNotIn("Candidate 1:", report)
        self.assertIn("No complete supported source-to-innerHTML trace", report)

    def test_unknown_helper_name_is_not_accepted_as_safety_proof(self):
        _, _, reports_dir = self.run_fixture(
            "const input = location.search;\\n"
            "const safeValue = customEscape(input);\\n"
            "target.innerHTML = safeValue;\\n"
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertNotIn("Candidate 1:", report)
        self.assertNotIn("Candidate 1:", report)
        self.assertIn("No complete supported source-to-innerHTML trace", report)

