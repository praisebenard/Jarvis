            "const input = location.search;\n"
            "const other = 'fixed';\n"
            "target.innerHTML = other;\n"
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
        self.assertIn("No complete supported source-to-innerHTML trace", report)
