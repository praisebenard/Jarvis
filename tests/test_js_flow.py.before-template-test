    def test_reassignment_invalidates_later_flow(self):
        _, _, reports_dir = self.run_fixture(
            "let input = location.search;\n"
            "input = 'fixed';\n"
            "target.innerHTML = input;\n"
        )
        report = next(reports_dir.glob("*_js_flow.txt")).read_text()
